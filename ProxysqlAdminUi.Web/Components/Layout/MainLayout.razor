@inherits LayoutComponentBase
@implements IDisposable
@inject AppVersion AppVersion
@inject LocalizationService L

<RadzenComponents @rendermode="InteractiveServer" />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenMenu>
                <RadzenMenuItem Text="@HomeText" Icon="home" Path="/" />
                <RadzenMenuItem Text="@UsersText" Icon="account_box" Path="/mysql/users" />
                <RadzenMenuItem Text="@ServersText" Icon="dns" Path="/mysql/servers" />
                <RadzenMenuItem Text="@GaleraHostgroupsText" Icon="hub" Path="/mysql/galera-hostgroups" />
                <RadzenMenuItem Text="@ReplicationHostgroupsText" Icon="account_tree" Path="/mysql/replication-hostgroups" />
                <RadzenMenuItem Text="@RulesText" Icon="quiz" Path="/mysql/rules" />
                <RadzenMenuItem Text="@DigestText" Icon="query_stats" Path="/mysql/queries/digest" />
                <RadzenMenuItem Text="@VariablesText" Icon="settings" Path="/proxysql/global-variables" />
                <RadzenMenuItem Text="@ActionsText" Icon="build" Path="/proxysql/actions" />
            </RadzenMenu>
            <LanguageSwitcher />
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody>
        <div @key="L.CurrentLanguage">
            @Body
        </div>
    </RadzenBody>
    <RadzenFooter Style="height:30px;padding-top:2px;">
        <RadzenBadge BadgeStyle="BadgeStyle.Info"><RadzenLink Style="color:white;" Path="@VersionUrl" Text="@AppVersion.Version" /></RadzenBadge>
    </RadzenFooter>
</RadzenLayout>

@code {
    private string HomeText => L["Home"];
    private string UsersText => L["MySQL Users"];
    private string ServersText => L["MySQL Servers"];
    private string ReplicationHostgroupsText => L["Replication Hostgroups"];
    private string GaleraHostgroupsText => L["Galera Hostgroups"];
    private string RulesText => L["Rules"];
    private string DigestText => L["Query Digest"];
    private string VariablesText => L["Global Variables"];
    private string ActionsText => L["Actions"];
    private string VersionUrl => $"https://github.com/Dotfinity/proxysql-admin-ui/releases/{AppVersion.Version}";

    protected override void OnInitialized() => L.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= Refresh;
}
