@page "/mysql/queries/digest"

@using System.Globalization
@using ProxysqlAdminUi.Web.Components.Pages.MySql.Rules
@using ProxysqlAdminUi.Web.Repositories
@using ProxysqlAdminUi.Web.ViewModel
@using System.Text.Json;
@using ProxysqlAdminUi.Web.Extensions

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject LocalizationService L

<RadzenCard>
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">@L["MySQL Query Digest Statistics"]</RadzenText>

    <RadzenDataGrid Visible="@_gridVisible"
                    Settings="@_gridSettings"
                    SettingsChanged="OnSettingsChanged"
                    AllowColumnPicking="true"
                    AllowColumnReorder="true"
                    AllowColumnResize="true"
                    AllowFiltering="true"
                    AllowMultiColumnSorting="true"
                    AllowPaging="true"
                    AllowPickAllColumns="true"
                    AllowSorting="true"
                    AllowVirtualization="false"
                    ColumnWidth="auto"
                    Data="@_queryDigests"
                    Density="Density.Default"
                    PageSize="300"
                    ShowColumnTitleAsTooltip="true"
                    TItem="QueryDigestViewModel"
                    >
        <EmptyTemplate>
            <RadzenText TagName="TagName.H3" Text='@L["No data to display"]' />
        </EmptyTemplate>
        <HeaderTemplate>
            <RadzenButton ButtonStyle="ButtonStyle.Primary" 
                          Icon="refresh" 
                          Text='@L["Refresh Data"]'
                          Size="ButtonSize.Medium"
                          Click="async () => await RefreshData()" />
        </HeaderTemplate>
        <Columns>

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.Hostgroup)"
                                  HeaderTooltip="Target server hostgroup" Title='@L["Hostgroup"]' Filterable="true" Sortable="true" Width="80px" />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.Schemaname)"
                                  HeaderTooltip="Database schema name" Title='@L["Schema"]' Filterable="true" Sortable="true"  />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.Username)"
                                  HeaderTooltip="User executing the queries" Title='@L["Username"]' Filterable="true" Sortable="true"  />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.ClientAddress)"
                                  HeaderTooltip="Client IP address" Title='@L["Client Address"]' Filterable="true" Sortable="true" />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.Digest)"
                                  HeaderTooltip="Query digest hash" Title='@L["Digest"]' Filterable="true" Sortable="false" Width="180px"
                                  MinWidth="100px" />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.DigestText)"
                                  Title='@L["Query"]' Sortable="false" Width="250px" MinWidth="300px">
                <Template Context="digest">
                    <RadzenButton Size="ButtonSize.Small" Text="@ExtractDigestText(digest)"
                                  Click="async ()=> await ClikShowQueryDialog(digest.DigestText)" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.CountStar)"
                                  HeaderTooltip="Total number of times this query pattern was executed" Title='@L["Query Count"]' FormatString="{0:### ### ### ### ##0}" Filterable="true"
                                  Sortable="true" />
            
            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.CacheHits)"
                                  HeaderTooltip="Total number of times this query pattern was executed" Title='@L["Cache Hits"]' FormatString="{0:### ### ### ### ##0}"  Filterable="true"
                                  Sortable="true" />
            
            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.FirstSeen)"
                                  HeaderTooltip="First time this query pattern was seen" Title='@L["First Seen"]' Filterable="true" Sortable="true"
                                  >
                <Template Context="digest">
                    @DateTimeOffset.FromUnixTimeSeconds(digest.FirstSeen).LocalDateTime
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.LastSeen)"
                                  HeaderTooltip="Last time this query pattern was seen" Title='@L["Last Seen"]' Filterable="true" Sortable="true"
                                  >
                <Template Context="digest">
                    @DateTimeOffset.FromUnixTimeSeconds(digest.LastSeen).LocalDateTime
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.SumTime)"
                                  HeaderTooltip="Total execution time in microseconds" Title='@L["Total Time"]' Filterable="true"
                                  Sortable="true">
                <Template Context="digest">
                    @FormatHelper.FormatMicroseconds(digest.SumTime)
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.MinTime)"
                                  HeaderTooltip="Minimum query execution time in microseconds" Title='@L["Min Time (μs)"]' FormatString="{0:### ### ### ### ##0}" Filterable="true"
                                  Sortable="true" />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.MaxTime)"
                                  HeaderTooltip="Maximum query execution time in microseconds" Title='@L["Max Time (μs)"]' FormatString="{0:### ### ### ### ##0}" Filterable="true"
                                  Sortable="true" />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.SumRowsAffected)"
                                  HeaderTooltip="Total number of rows affected by this query pattern" Title='@L["Rows Affected"]'  FormatString="{0:### ### ### ### ##0}" Filterable="true"
                                  Sortable="true" />

            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.SumRowsSent)"
                                  HeaderTooltip="Total number of rows returned by this query pattern" Title='@L["Rows Sent"]'  FormatString="{0:### ### ### ### ##0}" Filterable="true"
                                  Sortable="true" />


            <RadzenDataGridColumn TItem="QueryDigestViewModel" Property="@nameof(QueryDigestViewModel.RuleId)"
                                  HeaderTooltip="Associated routing rule ID if one exists" Title='@L["Rule ID"]' Filterable="true" Sortable="true"
                                  />

            <RadzenDataGridColumn Property="BtnCol" Filterable="false" Sortable="false" Pickable="false" Width="180px" MinWidth="180px" Visible="true">
                <Template Context="digest">
                    @if (!digest.HasRule)
                    {
                        <RadzenSplitButton Icon="add" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                           Click="async args => await CreateRule(digest,args)" Text='@L["Create Rule"]'>
                            <ChildContent>
                                <RadzenSplitButtonItem Text='@L["Cache 1 minute"]' Value="1" />
                                <RadzenSplitButtonItem Text='@L["Cache 5 minutes"]' Value="5" />
                                <RadzenSplitButtonItem Text='@L["Cache 10 minutes"]' Value="10" />
                                <RadzenSplitButtonItem Text='@L["Cache 30 minutes"]' Value="30" />
                                <RadzenSplitButtonItem Text='@L["Cache 1 hour"]' Value="60" />
                                <RadzenSplitButtonItem Text='@L["Cache 1 day"]' Value="1440" />
                            </ChildContent>
                        </RadzenSplitButton>
                    }
                    else if (digest.RuleId is int ruleId)
                    {
                        <RadzenButton ButtonStyle="ButtonStyle.Primary" Icon="edit" Text='@L["Edit Rule"]' Size="ButtonSize.Small"
                                      Click="async ()=> await EditRule(ruleId)" />
                    }
                    else
                    {
                        <RadzenText Text='@L["The associated rule is unavailable."]' />
                    }
                </Template>
            </RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    
    private const string ColumnSettingsKey = "queryDigestColumns";
    private bool _gridVisible;
    private IEnumerable<QueryDigestViewModel> _queryDigests = [];
    private DataGridSettings? _gridSettings;
    
    private static readonly string[] GridColumnProperties =
    [
        nameof(QueryDigestViewModel.Hostgroup),
        nameof(QueryDigestViewModel.Schemaname),
        nameof(QueryDigestViewModel.Username),
        nameof(QueryDigestViewModel.ClientAddress),
        nameof(QueryDigestViewModel.Digest),
        nameof(QueryDigestViewModel.DigestText),
        nameof(QueryDigestViewModel.CountStar),
        nameof(QueryDigestViewModel.CacheHits),
        nameof(QueryDigestViewModel.FirstSeen),
        nameof(QueryDigestViewModel.LastSeen),
        nameof(QueryDigestViewModel.SumTime),
        nameof(QueryDigestViewModel.MinTime),
        nameof(QueryDigestViewModel.MaxTime),
        nameof(QueryDigestViewModel.SumRowsAffected),
        nameof(QueryDigestViewModel.SumRowsSent),
        nameof(QueryDigestViewModel.RuleId)
    ];

    private static readonly HashSet<string> DefaultVisibleColumns =
    [
        nameof(QueryDigestViewModel.Hostgroup),
        nameof(QueryDigestViewModel.Digest),
        nameof(QueryDigestViewModel.DigestText),
        nameof(QueryDigestViewModel.CountStar),
        nameof(QueryDigestViewModel.CacheHits),
        nameof(QueryDigestViewModel.SumTime),
        nameof(QueryDigestViewModel.SumRowsSent)
    ];
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadColumnSettings();
            try
            {
                await RefreshData();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", 
                    $"Error loading query digests: {ex.Message}");
            }
        }
    }

    private async Task EditRule(int ruleId)
    {
        await DialogService.OpenAsync<EditQueryRuleDialog>("Edit Rule",
        new Dictionary<string, object?> { { "RuleId", ruleId } });

        // Refresh data after edit
        await RefreshData();
    }

    private async Task CreateRule(QueryDigestViewModel  digest, RadzenSplitButtonItem args)
    {
        await DialogService.OpenAsync<AddQueryRuleDialog>("Create Rule From Digest",
        new Dictionary<string, object?>
                  {
                      { "DigestParam", digest.Digest },
                      { "Minutes", int.Parse(args?.Value ?? "0")},
                      { "Username", digest.Username },
                      { "Schemaname", digest.Schemaname }
                  });

        // Refresh data after creation
        await RefreshData();
    }

    private static string ExtractDigestText(QueryDigestViewModel digest)
    {
        return digest.DigestText.Length > 30 ? digest.DigestText.Substring(0, 30) + "..." : digest.DigestText;
    }

    private async Task ClikShowQueryDialog(string digestText)
    {
        await DialogService.OpenAsync<QueryDigestTextDialog>("Query",
        new Dictionary<string, object?> { { "DigestText", digestText } },
        new DialogOptions()
            {
                Resizable = true,
                Draggable = true,
            }
        );
    }

    private async Task RefreshData()
    {
        _queryDigests = await ProxySqlRepository.GetStatsMySqlQueryDigests();
        StateHasChanged();
    }
    
    private async Task OnSettingsChanged(DataGridSettings settings)
    {
        _gridSettings = settings;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", ColumnSettingsKey, JsonSerializer.Serialize(settings));
    }
    
    private async Task LoadColumnSettings()
    {
        var savedSettings = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ColumnSettingsKey);
        _gridSettings = RestoreGridSettings(savedSettings);

        _gridVisible = true;
        StateHasChanged();
    }

    private static DataGridSettings RestoreGridSettings(string? savedSettings)
    {
        if (string.IsNullOrWhiteSpace(savedSettings))
        {
            return CreateGridSettings(DefaultVisibleColumns);
        }

        try
        {
            return JsonSerializer.Deserialize<DataGridSettings>(savedSettings)
                ?? CreateGridSettings(DefaultVisibleColumns);
        }
        catch (JsonException)
        {
            return CreateGridSettings(DefaultVisibleColumns);
        }
    }

    private static DataGridSettings CreateGridSettings(IEnumerable<string> visibleColumns)
    {
        var visibleColumnSet = visibleColumns.ToHashSet(StringComparer.Ordinal);
        return new DataGridSettings
        {
            Columns = GridColumnProperties.Select((property, index) => new DataGridColumnSettings
            {
                Property = property,
                Visible = visibleColumnSet.Contains(property),
                OrderIndex = index
            }).ToList()
        };
    }
}
