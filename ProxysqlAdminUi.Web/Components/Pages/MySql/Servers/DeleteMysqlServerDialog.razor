@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject DialogService DialogService
@inject NotificationService NotificationService

@if (_isLoading)
{
    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (_server is not null)
{
    <RadzenStack Gap="1rem">
        <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" Variant="Variant.Flat">
            This removes the server from ProxySQL, loads the new server configuration to Runtime, and saves it to Disk.
        </RadzenAlert>

        <RadzenCard>
            <RadzenStack Gap="0.5rem">
                <RadzenText><strong>Hostgroup:</strong> @_server.HostgroupId</RadzenText>
                <RadzenText><strong>Server:</strong> @_server.Hostname:@_server.Port</RadzenText>
                <RadzenText><strong>Status:</strong> @_server.Status</RadzenText>
                <RadzenText><strong>Weight:</strong> @_server.Weight</RadzenText>
            </RadzenStack>
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem">
            <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" Disabled="@_isDeleting" />
            <RadzenButton Text="Delete, load & persist" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                          Click="@DeleteAsync" IsBusy="@_isDeleting" Disabled="@_isDeleting" />
        </RadzenStack>
    </RadzenStack>
}

@code {
    [Parameter] public int HostgroupId { get; set; }
    [Parameter] public string Hostname { get; set; } = string.Empty;
    [Parameter] public int Port { get; set; }

    private MysqlServerModel? _server;
    private bool _isLoading = true;
    private bool _isDeleting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _server = await ProxySqlRepository.GetMySqlServer(HostgroupId, Hostname, Port)
                ?? throw new InvalidOperationException("The selected MySQL server was not found.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to load server", ex.Message);
            DialogService.Close(false);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteAsync()
    {
        _isDeleting = true;
        try
        {
            await ProxySqlRepository.DeleteMySqlServer(HostgroupId, Hostname, Port);
            NotificationService.Notify(
                NotificationSeverity.Success,
                "Server deleted",
                "The change is active in Runtime and saved to Disk.");
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to delete server", ex.Message);
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void Cancel() => DialogService.Close(false);
}
