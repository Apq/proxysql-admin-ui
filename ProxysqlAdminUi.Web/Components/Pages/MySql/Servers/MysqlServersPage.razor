@page "/mysql/servers"

@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject LocalizationService L

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="6">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">@L["MySQL Servers"]</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text='@L["Refresh"]' Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadServersAsync" Disabled="@_isLoading" />
                <RadzenButton Text='@L["Add server"]' Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@ShowAddModal" Disabled="@_isLoading" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    @if (_isLoading)
    {
        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
    }
    else
    {
        <RadzenDataGrid TItem="MysqlServerModel" Data="@_servers" AllowPaging="true" AllowSorting="true"
                        AllowFiltering="true" PageSize="20" EmptyText='@L["No MySQL servers found."]'>
            <Columns>
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.HostgroupId)" Title='@L["Hostgroup"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Hostname)" Title='@L["Hostname"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Port)" Title='@L["Port"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Status)" Title='@L["Status"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Weight)" Title='@L["Weight"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.MaxConnections)" Title='@L["Max connections"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.MaxReplicationLag)" Title='@L["Max replication lag"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Comment)" Title='@L["Comment"]' />
                <RadzenDataGridColumn TItem="MysqlServerModel" Title='@L["Actions"]' Filterable="false" Sortable="false" Width="190px">
                    <Template Context="server">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text='@L["Edit"]' Icon="edit" Size="ButtonSize.Small"
                                          Click="@(() => ShowEditModal(server))" />
                            <RadzenButton Text='@L["Delete"]' Icon="delete" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Click="@(() => ShowDeleteModal(server))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenStack>

@code {
    private List<MysqlServerModel> _servers = [];
    private bool _isLoading;

    protected override Task OnInitializedAsync() => LoadServersAsync();

    private async Task LoadServersAsync()
    {
        _isLoading = true;
        try
        {
            _servers = (await ProxySqlRepository.GetMySqlServers()).ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Failed to load servers"], ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowAddModal()
    {
        var changed = await DialogService.OpenAsync<EditMysqlServerDialog>(
            L["Add MySQL server"],
            options: GetDialogOptions());

        if (changed is true)
        {
            await LoadServersAsync();
        }
    }

    private async Task ShowEditModal(MysqlServerModel server)
    {
        var changed = await DialogService.OpenAsync<EditMysqlServerDialog>(
            $"{L["Edit"]} {server.Hostname}:{server.Port} in HG {server.HostgroupId}",
            new Dictionary<string, object?>
            {
                [nameof(EditMysqlServerDialog.HostgroupId)] = server.HostgroupId,
                [nameof(EditMysqlServerDialog.Hostname)] = server.Hostname,
                [nameof(EditMysqlServerDialog.Port)] = server.Port
            },
            GetDialogOptions());

        if (changed is true)
        {
            await LoadServersAsync();
        }
    }

    private async Task ShowDeleteModal(MysqlServerModel server)
    {
        var changed = await DialogService.OpenAsync<DeleteMysqlServerDialog>(
            $"{L["Delete"]} {server.Hostname}:{server.Port} from HG {server.HostgroupId}",
            new Dictionary<string, object?>
            {
                [nameof(DeleteMysqlServerDialog.HostgroupId)] = server.HostgroupId,
                [nameof(DeleteMysqlServerDialog.Hostname)] = server.Hostname,
                [nameof(DeleteMysqlServerDialog.Port)] = server.Port
            },
            new DialogOptions { CloseDialogOnEsc = true, Width = "560px" });

        if (changed is true)
        {
            await LoadServersAsync();
        }
    }

    private static DialogOptions GetDialogOptions() => new()
    {
        CloseDialogOnEsc = true,
        Width = "900px"
    };
}
