@page "/mysql/servers"
@inherits ConfigLayerTabsPageBase

@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject DialogService DialogService
@inject AppNotificationService NotificationService
@inject LocalizationService L

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="6">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">@L["MySQL Servers"]</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                <RadzenButton Text='@L["Refresh"]' Icon="refresh" ButtonStyle="ButtonStyle.Light"
                              Click="@RefreshCurrentLayerAsync" Disabled="@IsCurrentLayerLoading" />
                @if (CurrentLayer == ProxySqlConfigLayer.Main)
                {
                    <RadzenButton Text='@L["Add server"]' Icon="add" ButtonStyle="ButtonStyle.Primary"
                                  Click="@ShowAddModal" Disabled="@IsCurrentLayerLoading" />
                }
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenTabs @bind-SelectedIndex="_selectedLayerIndex" Change="@OnLayerChangedAsync">
        <Tabs>
            @foreach (var layer in ConfigLayers)
            {
                <RadzenTabsItem @key="layer" Text="@GetLayerLabel(layer)">
                    <RadzenStack Gap="0.75rem" class="rz-pt-3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="8">
                                <RadzenText TextStyle="TextStyle.Body2">
                                    @L["Data source"]: <code>@ProxySqlRepository.GetConfigTableName(layer, ProxySqlConfigTable.MysqlServers)</code>
                                </RadzenText>
                            </RadzenColumn>
                            @if (layer != ProxySqlConfigLayer.Main)
                            {
                                <RadzenColumn Size="4">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                                        <RadzenIcon Icon="lock" />
                                        <RadzenText TextStyle="TextStyle.Body2">@L["This layer is read-only."]</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            }
                        </RadzenRow>

                        @if (_loadingLayers.Contains(layer))
                        {
                            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
                        }
                        else
                        {
                            <RadzenDataGrid TItem="MysqlServerModel" Data="@GetServers(layer)" AllowPaging="true"
                                            AllowSorting="true" AllowFiltering="true" PageSize="20"
                                            EmptyText='@L["No MySQL servers found."]'>
                                <Columns>
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.HostgroupId)" Title='@L["Hostgroup"]' />
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Hostname)" Title='@L["Hostname"]' />
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Port)" Title='@L["Port"]' />
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Status)" Title='@L["Status"]' />
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Weight)" Title='@L["Weight"]' />
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.MaxConnections)" Title='@L["Max connections"]' />
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.MaxReplicationLag)" Title='@L["Max replication lag"]' />
                                    <RadzenDataGridColumn TItem="MysqlServerModel" Property="@nameof(MysqlServerModel.Comment)" Title='@L["Comment"]' />
                                    @if (layer == ProxySqlConfigLayer.Main)
                                    {
                                        <RadzenDataGridColumn TItem="MysqlServerModel" Title='@L["Actions"]' Filterable="false" Sortable="false" Width="190px">
                                            <Template Context="server">
                                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                                    <RadzenButton Text='@L["Edit"]' Icon="edit" Size="ButtonSize.Small"
                                                                  Click="@(() => ShowEditModal(server))" />
                                                    <RadzenButton Text='@L["Delete"]' Icon="delete" Size="ButtonSize.Small"
                                                                  ButtonStyle="ButtonStyle.Danger"
                                                                  Click="@(() => ShowDeleteModal(server))" />
                                                </RadzenStack>
                                            </Template>
                                        </RadzenDataGridColumn>
                                    }
                                </Columns>
                            </RadzenDataGrid>
                        }
                    </RadzenStack>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    private readonly Dictionary<ProxySqlConfigLayer, List<MysqlServerModel>> _serversByLayer = [];
    private readonly HashSet<ProxySqlConfigLayer> _loadedLayers = [];
    private readonly HashSet<ProxySqlConfigLayer> _loadingLayers = [];
    private bool IsCurrentLayerLoading => _loadingLayers.Contains(CurrentLayer);

    private Task RefreshCurrentLayerAsync() => LoadLayerAsync(CurrentLayer, force: true);

    protected override async Task LoadLayerAsync(ProxySqlConfigLayer layer, bool force = false)
    {
        if (!force && _loadedLayers.Contains(layer))
        {
            return;
        }

        _loadingLayers.Add(layer);
        try
        {
            _serversByLayer[layer] = (await ProxySqlRepository.GetMySqlServers(layer)).ToList();
            _loadedLayers.Add(layer);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                L["Failed to load servers"],
                $"{GetLayerLabel(layer)}: {ex.Message}");
        }
        finally
        {
            _loadingLayers.Remove(layer);
        }
    }

    private IReadOnlyList<MysqlServerModel> GetServers(ProxySqlConfigLayer layer)
        => _serversByLayer.GetValueOrDefault(layer) ?? [];

    private string GetLayerLabel(ProxySqlConfigLayer layer) => layer switch
    {
        ProxySqlConfigLayer.Main => L["Main (editable)"],
        ProxySqlConfigLayer.Runtime => L["Runtime (read-only)"],
        ProxySqlConfigLayer.Disk => L["Disk (read-only)"],
        _ => layer.ToString()
    };

    private async Task ReloadAfterMutationAsync()
    {
        _loadedLayers.Remove(ProxySqlConfigLayer.Runtime);
        _loadedLayers.Remove(ProxySqlConfigLayer.Disk);
        await LoadLayerAsync(ProxySqlConfigLayer.Main, force: true);
    }

    private async Task ShowAddModal()
    {
        var changed = await DialogService.OpenAsync<EditMysqlServerDialog>(
            L["Add MySQL server"],
            options: GetDialogOptions());

        if (changed is true)
        {
            await ReloadAfterMutationAsync();
        }
    }

    private async Task ShowEditModal(MysqlServerModel server)
    {
        var changed = await DialogService.OpenAsync<EditMysqlServerDialog>(
            $"{L["Edit"]} {server.Hostname}:{server.Port} in HG {server.HostgroupId}",
            new Dictionary<string, object?>
            {
                [nameof(EditMysqlServerDialog.HostgroupId)] = server.HostgroupId,
                [nameof(EditMysqlServerDialog.Hostname)] = server.Hostname,
                [nameof(EditMysqlServerDialog.Port)] = server.Port
            },
            GetDialogOptions());

        if (changed is true)
        {
            await ReloadAfterMutationAsync();
        }
    }

    private async Task ShowDeleteModal(MysqlServerModel server)
    {
        var changed = await DialogService.OpenAsync<DeleteMysqlServerDialog>(
            $"{L["Delete"]} {server.Hostname}:{server.Port} from HG {server.HostgroupId}",
            new Dictionary<string, object?>
            {
                [nameof(DeleteMysqlServerDialog.HostgroupId)] = server.HostgroupId,
                [nameof(DeleteMysqlServerDialog.Hostname)] = server.Hostname,
                [nameof(DeleteMysqlServerDialog.Port)] = server.Port
            },
            new DialogOptions { CloseDialogOnEsc = true, Width = "560px" });

        if (changed is true)
        {
            await ReloadAfterMutationAsync();
        }
    }

    private static DialogOptions GetDialogOptions() => new()
    {
        CloseDialogOnEsc = true,
        Width = "900px"
    };
}
