@page "/mysql/rules/delete/{RuleId:int}"

@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject LocalizationService L

<RadzenContent Container="main">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <RadzenTemplateForm TItem="MysqlQueryRuleModel" Data=@queryRule Submit=@OnConfirmDelete>
                <RadzenCard>
                    <div class="row">
                        <div class="col">
                            <h3 class="h5">@L["Confirm Delete"]</h3>
                            <div class="row mb-3">
                                <div class="col">
                                    <p>@L["Are you sure you want to delete Query Rule #"]@RuleId?</p>
                                    @if (queryRule != null)
                                    {
                                        <div class="alert alert-info">
                                            <strong>@L["Rule Details:"]</strong><br />
                                            @L["Rule ID"]: @queryRule.RuleId<br />
                                            @L["Active"]: @queryRule.Active<br />
                                            @L["Username"]: @queryRule.Username<br />
                                            @L["Schema Name"]: @queryRule.Schemaname<br />
                                            @L["Client Address"]: @queryRule.ClientAddr<br />
                                            @L["Proxy Address"]: @queryRule.ProxyAddr<br />
                                            @L["Match Digest"]: @queryRule.MatchDigest<br />
                                            @L["Match Pattern"]: @queryRule.MatchPattern
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="row">
                                <div class="col d-flex justify-content-end gap-2">
                                    <RadzenButton ButtonType="ButtonType.Submit" 
                                                Icon="delete" 
                                                Text='@L["Delete"]'
                                                ButtonStyle="ButtonStyle.Danger" />
                                    <RadzenButton ButtonType="ButtonType.Button"
                                                Icon="cancel" 
                                                Text='@L["Cancel"]'
                                                ButtonStyle="ButtonStyle.Light"
                                                Click=@OnCancel />
                                </div>
                            </div>
                        </div>
                    </div>
                </RadzenCard>
            </RadzenTemplateForm>
        </div>
    </div>
</RadzenContent>

@code {

    [Parameter]
    public int RuleId { get; set; }

    private MysqlQueryRuleModel? queryRule;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            queryRule = await ProxySqlRepository.GetMySqlQueryRule(RuleId)
                ?? throw new InvalidOperationException("The selected query rule was not found.");
        }
        catch (Exception ex)
        { 
            NotificationService.Notify(NotificationSeverity.Error, L["Error"], L["Failed to load query rule details."] + "\r\n" + ex.Message);

            DialogService.Close();
        }
        finally
        {
        }
    }

    private async Task OnConfirmDelete()
    {
        try
        {
            await ProxySqlRepository.DeleteMySqlQueryRule(RuleId);

            NotificationService.Notify(NotificationSeverity.Success, L["Success"],
                L["Query Rule #"] + RuleId + L[" has been deleted."]);
            DialogService.Close();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Error"],
                L["Failed to delete query rule."] + "\r\n" + ex.Message);
        }
    }

    private void OnCancel()
    {
        DialogService.Close();
    }
}
