@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject DialogService DialogService
@inject NotificationService NotificationService

@if (_isLoading)
{
    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else
{
    <RadzenTemplateForm TItem="MysqlUserModel" Data="@_user" Submit="@SaveAsync">
        <DataAnnotationsValidator />
        <RadzenStack Gap="1rem">
            <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" Variant="Variant.Flat">
                Saving updates the ProxySQL memory table, loads MySQL users to Runtime, and saves them to Disk.
            </RadzenAlert>

            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Username" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="_user.Username" Name="Username" Style="width: 100%" />
                    </RadzenFormField>
                    <RadzenRequiredValidator Component="Username" Text="Username is required" Popup="true" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Password" Variant="Variant.Outlined">
                        <RadzenPassword @bind-Value="_user.Password" Name="Password" Style="width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="4">
                    <RadzenFormField Text="Default hostgroup" Variant="Variant.Outlined">
                        <RadzenNumeric @bind-Value="_user.DefaultHostgroup" Name="DefaultHostgroup" Style="width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenFormField Text="Default schema" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="_user.DefaultSchema" Name="DefaultSchema" Style="width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenFormField Text="Max connections" Variant="Variant.Outlined">
                        <RadzenNumeric @bind-Value="_user.MaxConnections" Name="MaxConnections" Min="0" Style="width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="3"><RadzenCheckBox @bind-Value="_active" Name="Active" /><RadzenLabel Text=" Active" Component="Active" /></RadzenColumn>
                <RadzenColumn Size="3"><RadzenCheckBox @bind-Value="_useSsl" Name="UseSsl" /><RadzenLabel Text=" Use SSL" Component="UseSsl" /></RadzenColumn>
                <RadzenColumn Size="3"><RadzenCheckBox @bind-Value="_backend" Name="Backend" /><RadzenLabel Text=" Backend" Component="Backend" /></RadzenColumn>
                <RadzenColumn Size="3"><RadzenCheckBox @bind-Value="_frontend" Name="Frontend" /><RadzenLabel Text=" Frontend" Component="Frontend" /></RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="4"><RadzenCheckBox @bind-Value="_schemaLocked" Name="SchemaLocked" /><RadzenLabel Text=" Schema locked" Component="SchemaLocked" /></RadzenColumn>
                <RadzenColumn Size="4"><RadzenCheckBox @bind-Value="_transactionPersistent" Name="TransactionPersistent" /><RadzenLabel Text=" Transaction persistent" Component="TransactionPersistent" /></RadzenColumn>
                <RadzenColumn Size="4"><RadzenCheckBox @bind-Value="_fastForward" Name="FastForward" /><RadzenLabel Text=" Fast forward" Component="FastForward" /></RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Attributes" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="_user.Attributes" Name="Attributes" Style="width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenFormField Text="Comment" Variant="Variant.Outlined">
                        <RadzenTextBox @bind-Value="_user.Comment" Name="Comment" Style="width: 100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.75rem">
                <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@Cancel" Disabled="@_isSaving" />
                <RadzenButton Text="Save, load & persist" Icon="save" ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary" IsBusy="@_isSaving" Disabled="@_isSaving" />
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter] public string? Username { get; set; }
    [Parameter] public int? Backend { get; set; }

    private MysqlUserModel _user = new() { Username = string.Empty, Password = string.Empty, DefaultSchema = string.Empty };
    private bool _isLoading;
    private bool _isSaving;
    private bool IsEdit => !string.IsNullOrWhiteSpace(Username) && Backend.HasValue;

    private bool _active { get => _user.Active == 1; set => _user.Active = value ? 1 : 0; }
    private bool _useSsl { get => _user.UseSsl == 1; set => _user.UseSsl = value ? 1 : 0; }
    private bool _backend { get => _user.Backend == 1; set => _user.Backend = value ? 1 : 0; }
    private bool _frontend { get => _user.Frontend == 1; set => _user.Frontend = value ? 1 : 0; }
    private bool _schemaLocked { get => _user.SchemaLocked == 1; set => _user.SchemaLocked = value ? 1 : 0; }
    private bool _transactionPersistent { get => _user.TransactionPersistent == 1; set => _user.TransactionPersistent = value ? 1 : 0; }
    private bool _fastForward { get => _user.FastForward == 1; set => _user.FastForward = value ? 1 : 0; }

    protected override async Task OnInitializedAsync()
    {
        if (!IsEdit) return;

        _isLoading = true;
        try
        {
            _user = await ProxySqlRepository.GetMySqlUser(Username!, Backend!.Value)
                ?? throw new InvalidOperationException("The selected MySQL user was not found.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to load user", ex.Message);
            DialogService.Close(false);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        try
        {
            if (IsEdit)
            {
                await ProxySqlRepository.UpdateMySqlUser(Username!, Backend!.Value, _user);
            }
            else
            {
                await ProxySqlRepository.AddMySqlUser(_user);
            }

            NotificationService.Notify(NotificationSeverity.Success, IsEdit ? "User updated" : "User added",
                "The change is active in Runtime and saved to Disk.");
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to save user", ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => DialogService.Close(false);
}
