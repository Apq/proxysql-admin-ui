@page "/mysql/galera-hostgroups"
@inherits ConfigLayerTabsPageBase

@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories
@using ProxysqlAdminUi.Web.ViewModel
@using ProxysqlAdminUi.Web.Components.Pages.MySql.Servers

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject GaleraNodeWeightService GaleraNodeWeightService
@inject DialogService DialogService
@inject AppNotificationService NotificationService
@inject LocalizationService L

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="6">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">@L["Galera Hostgroups"]</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text='@L["Refresh"]' Icon="refresh" ButtonStyle="ButtonStyle.Light"
                              Click="@RefreshCurrentLayerAsync" Disabled="@IsCurrentLayerLoading" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenTabs @bind-SelectedIndex="_selectedLayerIndex" Change="@OnLayerChangedAsync">
        <Tabs>
            @foreach (var layer in ConfigLayers)
            {
                <RadzenTabsItem @key="layer" Text="@GetLayerLabel(layer)">
                    <RadzenStack Gap="1rem" class="rz-pt-3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="8">
                                <RadzenText TextStyle="TextStyle.Body2">
                                    @L["Data source"]: <code>@ProxySqlRepository.GetConfigTableName(layer, ProxySqlConfigTable.MysqlGaleraHostgroups)</code>
                                </RadzenText>
                            </RadzenColumn>
                            @if (layer != ProxySqlConfigLayer.Main)
                            {
                                <RadzenColumn Size="4">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                                        <RadzenIcon Icon="lock" />
                                        <RadzenText TextStyle="TextStyle.Body2">@L["This layer is read-only."]</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            }
                        </RadzenRow>

                        @if (_loadingLayers.Contains(layer))
                        {
                            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
                        }
                        else if (_errors.TryGetValue(layer, out var error))
                        {
                            <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" Variant="Variant.Flat">
                                @L["Failed to load Galera hostgroups"]: @error
                            </RadzenAlert>
                        }
                        else
                        {
                            var overview = GetOverview(layer);
                            <RadzenStack Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.H5">@L["Galera hostgroup definitions"]</RadzenText>
                                @if (overview.Definitions.Count == 0)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" Variant="Variant.Flat">
                                        @L["No Galera hostgroup definitions are configured in this layer."]
                                    </RadzenAlert>
                                }
                                else
                                {
                                    <RadzenDataGrid TItem="MysqlGaleraHostgroupModel" Data="@overview.Definitions"
                                                    AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="20">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.WriterHostgroup)"
                                                                  Title='@L["Writer hostgroup"]' />
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.BackupWriterHostgroup)"
                                                                  Title='@L["Backup writer hostgroup"]' />
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.ReaderHostgroup)"
                                                                  Title='@L["Reader hostgroup"]' />
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.OfflineHostgroup)"
                                                                  Title='@L["Offline hostgroup"]' />
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.Active)"
                                                                  Title='@L["Active"]'>
                                                <Template Context="definition">
                                                    <RadzenBadge BadgeStyle="@(definition.Active == 1 ? BadgeStyle.Success : BadgeStyle.Secondary)"
                                                                 Text="@(definition.Active == 1 ? L["Yes"] : L["No"])" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.MaxWriters)"
                                                                  Title='@L["Max writers"]' />
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.WriterIsAlsoReader)"
                                                                  Title='@L["Writer is also reader"]'>
                                                <Template Context="definition">@GetWriterIsAlsoReaderLabel(definition.WriterIsAlsoReader)</Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.MaxTransactionsBehind)"
                                                                  Title='@L["Max transactions behind"]' />
                                            <RadzenDataGridColumn TItem="MysqlGaleraHostgroupModel"
                                                                  Property="@nameof(MysqlGaleraHostgroupModel.Comment)"
                                                                  Title='@L["Comment"]' />
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                            </RadzenStack>

                            <RadzenStack Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.H5">@L["Hostgroup members"]</RadzenText>
                                @if (overview.Members.Count == 0)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" Variant="Variant.Flat">
                                        @L["No hostgroup members are configured in this layer."]
                                    </RadzenAlert>
                                }
                                else
                                {
                                    <RadzenDataGrid TItem="HostgroupMemberViewModel" Data="@overview.Members"
                                                    AllowPaging="true" AllowSorting="true" AllowFiltering="true" PageSize="20">
                                        <Columns>
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.HostgroupId)"
                                                                  Title='@L["Hostgroup"]' />
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Title='@L["Role"]' Filterable="false" Sortable="false">
                                                <Template Context="member">
                                                    <RadzenBadge BadgeStyle="@GetRoleStyle(member.Role)"
                                                                 Text="@GetRoleLabel(member.Role)" />
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Title='@L["Role source"]' Filterable="false" Sortable="false">
                                                <Template Context="member">@GetRoleSources(member)</Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.Hostname)"
                                                                  Title='@L["Hostname"]'>
                                                <Template Context="member">
                                                    @(member.HasMember ? member.Hostname : L["No configured member"])
                                                </Template>
                                            </RadzenDataGridColumn>
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.Port)"
                                                                  Title='@L["Port"]' />
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.Status)"
                                                                  Title='@L["Status"]' />
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.Weight)"
                                                                  Title='@L["ProxySQL routing weight"]' />
                                            @if (layer == ProxySqlConfigLayer.Runtime)
                                            {
                                                <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                      Title='@L["Galera quorum weight"]' Filterable="false" Sortable="false">
                                                    <Template Context="member">
                                                        @if (member.Server is null)
                                                        {
                                                            <span>@L["Unavailable"]</span>
                                                        }
                                                        else if (!GaleraNodeWeightService.IsConfigured)
                                                        {
                                                            <span>@L["Not configured"]</span>
                                                        }
                                                        else if (_nodeWeightStates.TryGetValue(GetEndpointKey(member), out var nodeState))
                                                        {
                                                            @if (nodeState.IsLoading)
                                                            {
                                                                <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" Style="width: 20px; height: 20px" />
                                                            }
                                                            else if (nodeState.Node is not null)
                                                            {
                                                                <RadzenBadge BadgeStyle="@(nodeState.Node.IsHealthyForChange ? BadgeStyle.Success : BadgeStyle.Warning)"
                                                                             Text="@nodeState.Node.Weight.ToString()" />
                                                            }
                                                            else
                                                            {
                                                                <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text='@L["Read failed"]'
                                                                             title="@nodeState.Error" />
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span>@L["Reading..."]</span>
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            }
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.MaxConnections)"
                                                                  Title='@L["Max connections"]' />
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.MaxReplicationLag)"
                                                                  Title='@L["Max replication lag"]' />
                                            <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                  Property="@nameof(HostgroupMemberViewModel.Comment)"
                                                                  Title='@L["Comment"]' />
                                            @if (layer == ProxySqlConfigLayer.Main)
                                            {
                                                <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                      Title='@L["Actions"]' Filterable="false" Sortable="false" Width="190px">
                                                    <Template Context="member">
                                                        @if (member.Server is not null)
                                                        {
                                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                                                <RadzenButton Text='@L["Edit"]' Icon="edit" Size="ButtonSize.Small"
                                                                              Click="@(() => ShowEditModal(member))" />
                                                                <RadzenButton Text='@L["Delete"]' Icon="delete" Size="ButtonSize.Small"
                                                                              ButtonStyle="ButtonStyle.Danger"
                                                                              Click="@(() => ShowDeleteModal(member))" />
                                                            </RadzenStack>
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            }
                                            else if (layer == ProxySqlConfigLayer.Runtime)
                                            {
                                                <RadzenDataGridColumn TItem="HostgroupMemberViewModel"
                                                                      Title='@L["Actions"]' Filterable="false" Sortable="false" Width="220px">
                                                    <Template Context="member">
                                                        @if (member.Server is not null)
                                                        {
                                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                                                <RadzenButton Text='@L["Quorum weight"]' Icon="balance" Size="ButtonSize.Small"
                                                                              ButtonStyle="ButtonStyle.Warning"
                                                                              title='@L["View or change Galera quorum weight"]'
                                                                              Disabled="@(!GaleraNodeWeightService.IsConfigured)"
                                                                              Click="@(() => ShowGaleraWeightModal(member))" />
                                                                <RadzenButton Icon="lan" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                              title='@L["View connection pool"]'
                                                                              Click="@(() => ViewConnectionPool(member.HostgroupId))" />
                                                            </RadzenStack>
                                                        }
                                                    </Template>
                                                </RadzenDataGridColumn>
                                            }
                                        </Columns>
                                    </RadzenDataGrid>
                                }
                            </RadzenStack>
                        }
                    </RadzenStack>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    private readonly Dictionary<ProxySqlConfigLayer, GaleraHostgroupOverviewViewModel> _overviews = [];
    private readonly Dictionary<string, GaleraNodeWeightRowState> _nodeWeightStates = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<ProxySqlConfigLayer, string> _errors = [];
    private readonly HashSet<ProxySqlConfigLayer> _loadedLayers = [];
    private readonly HashSet<ProxySqlConfigLayer> _loadingLayers = [];
    private bool IsCurrentLayerLoading => _loadingLayers.Contains(CurrentLayer);

    private Task RefreshCurrentLayerAsync() => LoadLayerAsync(CurrentLayer, force: true);

    private void ViewConnectionPool(int hostgroupId) =>
        NavigationManager.NavigateTo($"/mysql/backend-connections?hostgroupId={hostgroupId}");

    private async Task ReloadAfterMutationAsync()
    {
        _loadedLayers.Remove(ProxySqlConfigLayer.Runtime);
        _loadedLayers.Remove(ProxySqlConfigLayer.Disk);
        _overviews.Remove(ProxySqlConfigLayer.Runtime);
        _overviews.Remove(ProxySqlConfigLayer.Disk);
        await LoadLayerAsync(ProxySqlConfigLayer.Main, force: true);
    }

    private async Task ShowEditModal(HostgroupMemberViewModel member)
    {
        var server = member.Server;
        if (server is null)
        {
            return;
        }

        var changed = await DialogService.OpenAsync<EditMysqlServerDialog>(
            $"{L["Edit"]} {server.Hostname}:{server.Port} in HG {server.HostgroupId}",
            new Dictionary<string, object?>
            {
                [nameof(EditMysqlServerDialog.HostgroupId)] = server.HostgroupId,
                [nameof(EditMysqlServerDialog.Hostname)] = server.Hostname,
                [nameof(EditMysqlServerDialog.Port)] = server.Port
            },
            GetDialogOptions());

        if (changed is true)
        {
            await ReloadAfterMutationAsync();
        }
    }

    private async Task ShowGaleraWeightModal(HostgroupMemberViewModel member)
    {
        var server = member.Server;
        if (server is null)
        {
            return;
        }

        var changed = await DialogService.OpenAsync<EditGaleraNodeWeightDialog>(
            $"{L["Galera quorum weight"]}: {server.Hostname}:{server.Port}",
            new Dictionary<string, object?>
            {
                [nameof(EditGaleraNodeWeightDialog.HostgroupId)] = server.HostgroupId,
                [nameof(EditGaleraNodeWeightDialog.Hostname)] = server.Hostname,
                [nameof(EditGaleraNodeWeightDialog.Port)] = server.Port
            },
            new DialogOptions { CloseDialogOnEsc = true, Width = "760px" });

        if (changed is true)
        {
            await RefreshNodeWeightAsync(member);
        }
    }

    private async Task ShowDeleteModal(HostgroupMemberViewModel member)
    {
        var server = member.Server;
        if (server is null)
        {
            return;
        }

        var changed = await DialogService.OpenAsync<DeleteMysqlServerDialog>(
            $"{L["Delete"]} {server.Hostname}:{server.Port} from HG {server.HostgroupId}",
            new Dictionary<string, object?>
            {
                [nameof(DeleteMysqlServerDialog.HostgroupId)] = server.HostgroupId,
                [nameof(DeleteMysqlServerDialog.Hostname)] = server.Hostname,
                [nameof(DeleteMysqlServerDialog.Port)] = server.Port
            },
            new DialogOptions { CloseDialogOnEsc = true, Width = "560px" });

        if (changed is true)
        {
            await ReloadAfterMutationAsync();
        }
    }

    private static DialogOptions GetDialogOptions() => new()
    {
        CloseDialogOnEsc = true,
        Width = "900px"
    };

    protected override async Task LoadLayerAsync(ProxySqlConfigLayer layer, bool force = false)
    {
        if (!force && _loadedLayers.Contains(layer))
        {
            return;
        }

        _loadingLayers.Add(layer);
        _errors.Remove(layer);
        try
        {
            _overviews[layer] = await ProxySqlRepository.GetGaleraHostgroupOverview(layer);
            _loadedLayers.Add(layer);
            if (layer == ProxySqlConfigLayer.Runtime && GaleraNodeWeightService.IsConfigured)
            {
                await LoadNodeWeightsAsync(_overviews[layer]);
            }
        }
        catch (Exception ex)
        {
            _errors[layer] = ex.Message;
            NotificationService.Notify(
                NotificationSeverity.Error,
                L["Failed to load Galera hostgroups"],
                $"{GetLayerLabel(layer)}: {ex.Message}");
        }
        finally
        {
            _loadingLayers.Remove(layer);
        }
    }

    private GaleraHostgroupOverviewViewModel GetOverview(ProxySqlConfigLayer layer)
        => _overviews.GetValueOrDefault(layer) ?? new GaleraHostgroupOverviewViewModel();

    private async Task LoadNodeWeightsAsync(GaleraHostgroupOverviewViewModel overview)
    {
        var members = overview.Members
            .Where(member => member.Server is not null)
            .GroupBy(GetEndpointKey, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();

        foreach (var member in members)
        {
            _nodeWeightStates[GetEndpointKey(member)] = GaleraNodeWeightRowState.Loading;
        }

        var tasks = members.Select(async member =>
        {
            var key = GetEndpointKey(member);
            var server = member.Server!;
            try
            {
                var node = await GaleraNodeWeightService.InspectAsync(
                    server.HostgroupId,
                    server.Hostname,
                    server.Port);
                _nodeWeightStates[key] = new GaleraNodeWeightRowState(false, node, null);
            }
            catch (Exception ex)
            {
                _nodeWeightStates[key] = new GaleraNodeWeightRowState(false, null, ex.Message);
            }
        });

        await Task.WhenAll(tasks);
    }

    private async Task RefreshNodeWeightAsync(HostgroupMemberViewModel member)
    {
        var server = member.Server;
        if (server is null)
        {
            return;
        }

        var key = GetEndpointKey(member);
        _nodeWeightStates[key] = GaleraNodeWeightRowState.Loading;
        try
        {
            var node = await GaleraNodeWeightService.InspectAsync(
                server.HostgroupId,
                server.Hostname,
                server.Port);
            _nodeWeightStates[key] = new GaleraNodeWeightRowState(false, node, null);
        }
        catch (Exception ex)
        {
            _nodeWeightStates[key] = new GaleraNodeWeightRowState(false, null, ex.Message);
        }
    }

    private static string GetEndpointKey(HostgroupMemberViewModel member) =>
        $"{member.Hostname}:{member.Port}";

    private string GetLayerLabel(ProxySqlConfigLayer layer) => layer switch
    {
        ProxySqlConfigLayer.Main => L["Main (editable)"],
        ProxySqlConfigLayer.Runtime => L["Runtime (read-only)"],
        ProxySqlConfigLayer.Disk => L["Disk (read-only)"],
        _ => layer.ToString()
    };

    private string GetRoleLabel(HostgroupRole role) => role switch
    {
        HostgroupRole.Writer => L["Writer"],
        HostgroupRole.BackupWriter => L["Backup writer"],
        HostgroupRole.Reader => L["Reader"],
        HostgroupRole.Offline => L["Offline"],
        HostgroupRole.Conflict => L["Role conflict"],
        _ => L["Undefined hostgroup"]
    };

    private static BadgeStyle GetRoleStyle(HostgroupRole role) => role switch
    {
        HostgroupRole.Writer => BadgeStyle.Success,
        HostgroupRole.BackupWriter => BadgeStyle.Warning,
        HostgroupRole.Reader => BadgeStyle.Info,
        HostgroupRole.Offline => BadgeStyle.Secondary,
        HostgroupRole.Conflict => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };

    private string GetRoleSources(HostgroupMemberViewModel member)
    {
        if (member.AssignedRoles.Count == 0)
        {
            return L["No role definition"];
        }

        return string.Join(", ", member.AssignedRoles.Select(role => role switch
        {
            HostgroupRole.Writer => "writer_hostgroup",
            HostgroupRole.BackupWriter => "backup_writer_hostgroup",
            HostgroupRole.Reader => "reader_hostgroup",
            HostgroupRole.Offline => "offline_hostgroup",
            _ => role.ToString()
        }));
    }

    private string GetWriterIsAlsoReaderLabel(int value) => value switch
    {
        0 => $"0 — {L["Writer is not also reader"]}",
        1 => $"1 — {L["Writer can also be reader"]}",
        2 => $"2 — {L["Only backup writers are also readers"]}",
        _ => value.ToString()
    };
}
