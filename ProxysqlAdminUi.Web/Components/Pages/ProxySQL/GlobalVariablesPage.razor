@page "/proxysql/global-variables"

@using ProxysqlAdminUi.Web.Models
@using ProxysqlAdminUi.Web.Repositories

@attribute [Authorize]

@inject ProxySqlRepository ProxySqlRepository
@inject NotificationService NotificationService
@inject LocalizationService L

<RadzenStack Gap="1rem">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="6">
            <RadzenText TextStyle="TextStyle.H3" TagName="TagName.H1">@L["Global Variables"]</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text='@L["Refresh"]' Icon="refresh" ButtonStyle="ButtonStyle.Light"
                              Click="@RefreshCurrentLayerAsync" Disabled="@IsCurrentLayerLoading" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenTabs @bind-SelectedIndex="_selectedLayerIndex" Change="@OnLayerChangedAsync">
        <Tabs>
            @foreach (var layer in ConfigLayers)
            {
                <RadzenTabsItem @key="layer" Text="@GetLayerLabel(layer)">
                    <RadzenStack Gap="0.75rem" class="rz-pt-3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="8">
                                <RadzenText TextStyle="TextStyle.Body2">
                                    @L["Data source"]: <code>@ProxySqlRepository.GetConfigTableName(layer, ProxySqlConfigTable.GlobalVariables)</code>
                                </RadzenText>
                            </RadzenColumn>
                            @if (layer != ProxySqlConfigLayer.Main)
                            {
                                <RadzenColumn Size="4">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem">
                                        <RadzenIcon Icon="lock" />
                                        <RadzenText TextStyle="TextStyle.Body2">@L["This layer is read-only."]</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            }
                        </RadzenRow>

                        @if (_loadingLayers.Contains(layer))
                        {
                            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
                        }
                        else if (layer == ProxySqlConfigLayer.Main)
                        {
                            <RadzenDataGrid @ref="_variablesGrid" Data="@GetVariables(layer)" TItem="GlobalVariableModel"
                                            AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="20"
                                            EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow">
                                <Columns>
                                    <RadzenDataGridColumn TItem="GlobalVariableModel" Property="@nameof(GlobalVariableModel.VariableName)"
                                                          Title='@L["Variable Name"]' Width="300px">
                                        <FooterTemplate>
                                            @L["Total Variables"]: @GetVariables(layer).Count
                                        </FooterTemplate>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlobalVariableModel" Property="@nameof(GlobalVariableModel.VariableValue)"
                                                          Title='@L["Value"]' Width="300px">
                                        <EditTemplate Context="variable">
                                            <RadzenTextBox @bind-Value="variable.VariableValue" Style="width:100%" Name="Value" />
                                            <RadzenRequiredValidator Text='@L["Value is required"]' Component="Value" Popup="true" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlobalVariableModel" Context="variable"
                                                          Width="100px" Filterable="false" Sortable="false"
                                                          TextAlign="TextAlign.Center" Title='@L["Actions"]'>
                                        <Template Context="variable">
                                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                                          Size="ButtonSize.Medium" Click="@(() => EditRow(variable))" />
                                        </Template>
                                        <EditTemplate Context="variable">
                                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                                          Size="ButtonSize.Medium" Click="@(() => SaveRow(variable))" />
                                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                                          Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1"
                                                          Click="@(() => CancelEdit(variable))" />
                                        </EditTemplate>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        }
                        else
                        {
                            <RadzenDataGrid Data="@GetVariables(layer)" TItem="GlobalVariableModel"
                                            AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="20">
                                <Columns>
                                    <RadzenDataGridColumn TItem="GlobalVariableModel" Property="@nameof(GlobalVariableModel.VariableName)"
                                                          Title='@L["Variable Name"]' Width="300px">
                                        <FooterTemplate>
                                            @L["Total Variables"]: @GetVariables(layer).Count
                                        </FooterTemplate>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="GlobalVariableModel" Property="@nameof(GlobalVariableModel.VariableValue)"
                                                          Title='@L["Value"]' Width="300px" />
                                </Columns>
                            </RadzenDataGrid>
                        }
                    </RadzenStack>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
</RadzenStack>

@code {
    private static readonly ProxySqlConfigLayer[] ConfigLayers = Enum.GetValues<ProxySqlConfigLayer>();
    private readonly Dictionary<ProxySqlConfigLayer, List<GlobalVariableModel>> _variablesByLayer = [];
    private readonly HashSet<ProxySqlConfigLayer> _loadedLayers = [];
    private readonly HashSet<ProxySqlConfigLayer> _loadingLayers = [];
    private readonly Dictionary<string, string> _originalValues = [];
    private RadzenDataGrid<GlobalVariableModel>? _variablesGrid;
    private int _selectedLayerIndex;

    private ProxySqlConfigLayer CurrentLayer => ConfigLayers[_selectedLayerIndex];
    private bool IsCurrentLayerLoading => _loadingLayers.Contains(CurrentLayer);

    protected override Task OnInitializedAsync() => LoadLayerAsync(ProxySqlConfigLayer.Main);

    private async Task OnLayerChangedAsync(int index)
    {
        _selectedLayerIndex = index;
        await LoadLayerAsync(CurrentLayer);
    }

    private Task RefreshCurrentLayerAsync() => LoadLayerAsync(CurrentLayer, force: true);

    private async Task LoadLayerAsync(ProxySqlConfigLayer layer, bool force = false)
    {
        if (!force && _loadedLayers.Contains(layer))
        {
            return;
        }

        _loadingLayers.Add(layer);
        try
        {
            _variablesByLayer[layer] = (await ProxySqlRepository.GetGlobalVariables(layer)).ToList();
            _loadedLayers.Add(layer);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                L["Failed to load global variables"],
                $"{GetLayerLabel(layer)}: {ex.Message}");
        }
        finally
        {
            _loadingLayers.Remove(layer);
        }
    }

    private IReadOnlyList<GlobalVariableModel> GetVariables(ProxySqlConfigLayer layer)
        => _variablesByLayer.GetValueOrDefault(layer) ?? [];

    private string GetLayerLabel(ProxySqlConfigLayer layer) => layer switch
    {
        ProxySqlConfigLayer.Main => L["Main (editable)"],
        ProxySqlConfigLayer.Runtime => L["Runtime (read-only)"],
        ProxySqlConfigLayer.Disk => L["Disk (read-only)"],
        _ => layer.ToString()
    };

    private async Task EditRow(GlobalVariableModel variable)
    {
        _originalValues[variable.VariableName] = variable.VariableValue;
        if (_variablesGrid is not null)
        {
            await _variablesGrid.EditRow(variable);
        }
    }

    private async Task OnUpdateRow(GlobalVariableModel variable)
    {
        try
        {
            await ProxySqlRepository.UpdateGlobalVariable(variable);
            _loadedLayers.Remove(ProxySqlConfigLayer.Runtime);
            _loadedLayers.Remove(ProxySqlConfigLayer.Disk);
            NotificationService.Notify(NotificationSeverity.Success, L["Success"], L["Variable updated"]);
            _originalValues.Remove(variable.VariableName);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, L["Error"], ex.Message);
            _originalValues.Remove(variable.VariableName);
            await LoadLayerAsync(ProxySqlConfigLayer.Main, force: true);
        }
    }

    private async Task SaveRow(GlobalVariableModel variable)
    {
        if (_variablesGrid is not null)
        {
            await _variablesGrid.UpdateRow(variable);
        }
    }

    private void CancelEdit(GlobalVariableModel variable)
    {
        if (_originalValues.Remove(variable.VariableName, out var originalValue))
        {
            variable.VariableValue = originalValue;
        }

        _variablesGrid?.CancelEditRow(variable);
    }
}
